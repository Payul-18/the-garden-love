# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube a GitHub (ya está en .gitignore).

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Nombre con el que la saluda la portada
VITE_NOMBRE_ELLA=su-apodo

# Llave de 4 dígitos que se escribe en la portada (día y mes de una fecha
# de ustedes dos: sin el año, para que sirva siempre)
VITE_LLAVE_JARDIN=0000

# Ruta del panel de administración. Invéntate algo que nadie adivine.
VITE_RUTA_ADMIN=tu-ruta-secreta

# Clave del panel. Debe coincidir EXACTAMENTE con la que guardaste en la
# tabla config de Supabase (ver base-de-datos/02-clave-admin.sql.ejemplo).
VITE_CLAVE_ADMIN=tu-clave-larga-y-aleatoria
